<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eubi.initiativetracker.swingui.EditNPCHealth">
  <grid id="27dc6" binding="editNPCHealth" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="5" left="5" bottom="5" right="5"/>
    </border>
    <children>
      <component id="7e5e8" class="javax.swing.JComboBox" binding="characterCombo">
        <constraints>
          <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="f2931" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="NPC to edit"/>
        </properties>
      </component>
      <component id="eeb55" class="javax.swing.JSeparator">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="5" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="5aa7c" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Name"/>
        </properties>
      </component>
      <component id="661a6" class="javax.swing.JLabel" binding="nameLabel">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Label"/>
        </properties>
      </component>
      <component id="add41" class="javax.swing.JSpinner" binding="changeValueSpinner">
        <constraints>
          <grid row="3" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties/>
      </component>
      <hspacer id="880bc">
        <constraints>
          <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
      </hspacer>
      <hspacer id="e9d3a">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
      </hspacer>
      <component id="87781" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Change (-/+)"/>
        </properties>
      </component>
      <component id="db2a3" class="javax.swing.JLabel" binding="currentHealth">
        <constraints>
          <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Label"/>
        </properties>
      </component>
      <component id="31b1c" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Difference"/>
        </properties>
      </component>
      <component id="be47d" class="javax.swing.JLabel" binding="newHealth">
        <constraints>
          <grid row="4" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Label"/>
        </properties>
      </component>
      <component id="28c3c" class="javax.swing.JButton" binding="saveEditButton" default-binding="true">
        <constraints>
          <grid row="5" column="3" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Save Edit"/>
        </properties>
      </component>
      <component id="46a35" class="javax.swing.JLabel" binding="saveEditLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Saved Edit"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
