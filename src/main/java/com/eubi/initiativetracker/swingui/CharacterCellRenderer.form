<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eubi.initiativetracker.swingui.CharacterCellRenderer">
  <grid id="27dc6" binding="listPanel" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="8" left="12" bottom="8" right="12"/>
    </border>
    <children>
      <component id="589c2" class="javax.swing.JLabel" binding="nameLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="SansSerif" size="20" style="1"/>
          <text value="Label"/>
        </properties>
      </component>
      <component id="873e5" class="javax.swing.JLabel" binding="initiativeLabel">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="SansSerif" size="14" style="1"/>
          <text value="Label"/>
        </properties>
      </component>
      <component id="38d4d" class="javax.swing.JLabel" binding="characterTypeLabel">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="SansSerif" size="14" style="1"/>
          <text value="Label"/>
