<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eubi.initiativetracker.swingui.EditCharacterMenu">
  <grid id="27dc6" binding="editCharacterPane" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="5" left="5" bottom="5" right="5"/>
    </border>
    <children>
      <component id="145bc" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Name"/>
        </properties>
      </component>
      <component id="72b16" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Initiative"/>
        </properties>
      </component>
      <component id="e109b" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Dexterity"/>
        </properties>
      </component>
      <component id="c7e7a" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Death Status"/>
        </properties>
      </component>
      <component id="2781c" class="javax.swing.JSeparator">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="68437" class="javax.swing.JLabel" binding="characterNameLabel">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <enabled value="true"/>
          <text value="Label"/>
        </properties>
      </component>
      <component id="41d93" class="javax.swing.JSpinner" binding="newInitiativeSpinner">
        <constraints>
          <grid row="3" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="bd990" class="javax.swing.JLabel" binding="initiativeLabel">
        <constraints>
          <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Label"/>
        </properties>
      </component>
      <component id="86587" class="javax.swing.JLabel" binding="dexterityLabel">
        <constraints>
          <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Label"/>
        </properties>
      </component>
      <component id="74669" class="javax.swing.JLabel" binding="deathStatusLabel">
        <constraints>
          <grid row="5" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Label"/>
        </properties>
      </component>
      <component id="ed3c" class="javax.swing.JSpinner" binding="newDexteritySpinner">
        <constraints>
          <grid row="4" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="2fe77" class="javax.swing.JComboBox" binding="newDeathStatusCombo">
        <constraints>
          <grid row="5" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <model>
            <item value="ALIVE"/>
            <item value="DEAD"/>
            <item value="DOWN"/>
          </model>
        </properties>
      </component>
      <component id="e4520" class="javax.swing.JComboBox" binding="charactersCombo">
        <constraints>
          <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <model/>
        </properties>
      </component>
      <component id="ccf25" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Character to Edit"/>
        </properties>
      </component>
      <component id="e591e" class="javax.swing.JButton" binding="saveEditButton" default-binding="true">
        <constraints>
          <grid row="6" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="0" bottom="5" right="0" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Save Edit"/>
        </properties>
      </component>
      <component id="c9dbe" class="javax.swing.JLabel" binding="savedCharacterLabel">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="0" bottom="0" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Character Saved!!"/>
          <visible value="true"/>
        </properties>
      </component>
      <hspacer id="fddfa">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </hspacer>
      <hspacer id="ee23a">
        <constraints>
          <grid row="5" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </hspacer>
    </children>
  </grid>
</form>
