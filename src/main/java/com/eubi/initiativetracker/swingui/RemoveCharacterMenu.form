<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eubi.initiativetracker.swingui.RemoveCharacterMenu">
  <grid id="27dc6" binding="removeCharacterPane" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="515" height="400"/>
    </constraints>
    <properties>
      <font name="SansSerif"/>
    </properties>
    <border type="empty">
      <size top="5" left="5" bottom="5" right="5"/>
    </border>
    <children>
      <component id="8887d" class="javax.swing.JComboBox" binding="characterSelectionCombo">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <model/>
        </properties>
      </component>
      <component id="ce5e3" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Select Character"/>
        </properties>
      </component>
      <component id="b7c3" class="javax.swing.JButton" binding="removeCharacterButton" default-binding="true">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Remove Character"/>
        </properties>
      </component>
      <component id="2a88f" class="javax.swing.JSeparator">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="9a4b7" class="javax.swing.JLabel" binding="removedCharacterLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Character(s) Removed!!!"/>
        </properties>
      </component>
      <hspacer id="1334d">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </hspacer>
    </children>
  </grid>
</form>
