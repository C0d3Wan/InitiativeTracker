<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eubi.initiativetracker.swingui.AddCharacterMenu">
  <grid id="27dc6" binding="addCharacterPane" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="637" height="400"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="5" left="5" bottom="5" right="5"/>
    </border>
    <children>
      <component id="cd6c6" class="javax.swing.JTextField" binding="characterName">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
          <gridbag top="0" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="6fe1a" class="javax.swing.JComboBox" binding="characterTypeCombo">
        <constraints>
          <grid row="3" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <model>
            <item value="PLAYER"/>
            <item value="ENEMY"/>
            <item value="ALLY"/>
          </model>
        </properties>
      </component>
      <component id="c7ad3" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Character Name"/>
        </properties>
      </component>
      <component id="7381e" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Initiative"/>
        </properties>
      </component>
      <component id="2e42f" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Dexterity (0-30)"/>
        </properties>
      </component>
      <component id="481b0" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Character Type"/>
        </properties>
      </component>
      <component id="bad07" class="javax.swing.JSpinner" binding="initiativeSpinner">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="a791a" class="javax.swing.JSpinner" binding="dexteritySpinner">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="1dcde" class="javax.swing.JButton" binding="addCharacterButton" default-binding="true">
        <constraints>
          <grid row="6" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="0" bottom="2" right="0" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <focusPainted value="false"/>
          <opaque value="true"/>
          <text value="Add character"/>
        </properties>
      </component>
      <component id="b53a6" class="javax.swing.JComboBox" binding="deathStatusCombo">
        <constraints>
          <grid row="5" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="5" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <model>
            <item value="ALIVE"/>
            <item value="DEAD"/>
            <item value="DOWN"/>
          </model>
        </properties>
      </component>
      <component id="fd410" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="5" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Death Status"/>
        </properties>
      </component>
      <hspacer id="7fc83">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
      </hspacer>
      <component id="578b8" class="javax.swing.JLabel" binding="maxHealthLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Max Health"/>
        </properties>
      </component>
      <component id="1012" class="javax.swing.JSpinner" binding="maxHealthSpinner">
        <constraints>
          <grid row="4" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="2" left="0" bottom="2" right="0" weightx="0.0" weighty="1.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="2bf9c" class="javax.swing.JLabel" binding="savedCharacterLabel">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="0" bottom="2" right="0" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Character Saved!!!"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
