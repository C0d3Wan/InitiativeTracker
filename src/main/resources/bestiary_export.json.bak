        {
          "category": "Action",
          "name": "Anguishing Bite",
          "description": "Melee Weapon Attack: +10 to hit, reach 5 ft., one target. Hit: 9 (1d10 + 4) piercing damage plus 10 (3d6) psychic damage. If the target is a creature, it can't regain hit points until the start of the baernaloth's next turn."
        },
        {
          "category": "Action",
          "name": "Claw",
          "description": "Melee Weapon Attack: +10 to hit, reach 10 ft., one target. Hit: 11 (2d6 + 4) slashing damage plus 17 (5d6) necrotic damage."
        },
        {
          "category": "Action",
          "name": "Miasma of Discord",
          "description": "The baernaloth exhales gray vapors that coalesce at a point it can see within 120 feet of itself in a 20-foot-radius sphere. Each non-yugoloth creature in that area must make a DC 19 Wisdom saving throw. On a failed save, the creature takes 35 (10d6) psychic damage and has the charmed condition until the end of its next turn (treating allies as foes). On a successful save, half damage only.",
          "recharge": "5-6"
        },
        {
          "category": "Action",
          "name": "Spellcasting",
          "description": "The baernaloth casts one of the following spells, requiring no material components and using Intelligence as the spellcasting ability (spell save DC 20):\nAt will: detect thoughts, phantasmal force, suggestion\n1/day each: cloudkill, plane shift (self only), scrying (as an action)"
        },
        {
          "category": "Action",
          "name": "Summon Yugoloth (1/Day)",
          "description": "The baernaloth has a 50 percent chance of summoning its choice of 1d4 mezzoloths, 1 arcanaloth, or 1 baernaloth within 60 feet for 1 minute.",
          "recharge": "1/Day"
        },
        {
          "category": "Action",
          "name": "Teleport",
          "description": "The baernaloth teleports, along with any equipment it is wearing or carrying, up to 120 feet to an unoccupied space it can see."
        },
        {
          "category": "Reaction",
          "name": "Afflict Despair",
          "description": "The baernaloth can take up to three reactions per round but only one per turn. When a creature that the baernaloth can see within 60 feet hits with an attack roll or succeeds on a saving throw, the baernaloth forces the creature to reroll the d20 and use the new result."
        },
        {
          "category": "Reaction",
          "name": "Inescapable Pain",
          "description": "When the baernaloth is damaged by another creature, that creature must make a DC 19 Constitution saving throw, taking 14 (4d6) necrotic damage on a failed save, or half as much damage on a successful one."
        },
        {
          "category": "Lair Action",
          "name": "Lair Actions",
          "description": "On initiative count 20 (losing initiative ties), a baernaloth can take one of the following lair actions:\n• Consume Suffering: Until initiative count 20 on the next round, when another creature in the lair takes necrotic or psychic damage or drops to 0 HP, the baernaloth regains 10 (3d6) HP.\n• Discover Secrets: Casts detect thoughts; targeted creature takes 13 (3d8) psychic damage.\n• Recurring Wound: A creature missing HP must make a DC 19 Constitution save, taking 22 (4d10) necrotic damage on a failed save, or half on a success."
        }
      ],
      "tags": [
        "Legendary",
        "Fiend",
        "Yugoloth"
      ]
    },
