        }
      ],
      "senses": [
        {
          "sense": "Darkvision",
          "rangeFt": 120
        },
        {
          "sense": "Blindsight",
          "rangeFt": 60
        }
      ],
      "damageModifiers": [
        {
          "modifier": "Resistance",
          "damageType": "Necrotic"
        },
        {
          "modifier": "Immunity",
          "damageType": "Fire"
        }
      ],
      "conditionImmunities": [],
