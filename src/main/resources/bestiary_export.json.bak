      "conditionImmunities": [
        "Prone"
      ],
      "languages": [],
      "abilities": [
        {
          "category": "Action",
          "name": "Bites",
          "description": "Melee Weapon Attack: +2 to hit, reach 5 ft., one creature. Hit: 17 (5d6) piercing damage. If the target is slain by this damage, it is absorbed into the mouther."
        },
        {
          "category": "Action",
          "name": "Blinding Spittle",
          "description": "The mouther spits a glob of acidic slime at a point it can see within 30 feet. Each creature within 5 feet of that point must succeed on a DC 13 Dexterity saving throw or be blinded until the end of the mouther's next turn."
        },
        {
          "category": "Action",
          "name": "Multiattack",
          "description": "The gibbering mouther makes one bite attack and as many blinding spittle attacks as it can."
        },
        {
          "category": "Trait",
          "name": "Aberrant Ground",
          "description": "The ground in a 10-foot radius around the mouther is sticky and difficult terrain. Each creature that starts its turn in that area must succeed on a DC 10 Strength saving throw or have its speed reduced to 0 until the start of its next turn."
        },
        {
          "category": "Trait",
          "name": "Amphibious",
          "description": "The gibbering mouther can breathe air and water."
        },
        {
          "category": "Trait",
          "name": "Gibbering",
          "description": "The mouther babbles incoherently while it can see any creature and isn't incapacitated. Each creature that starts its turn within 20 feet of the mouther and can hear the gibbering must succeed on a DC 10 Wisdom saving throw or be subjected to short-term madness."
        }
      ],
      "tags": [
        "Amphibious",
        "Aberration"
      ]
    },
