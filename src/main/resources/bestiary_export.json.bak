          "bonus": 3
        }
      ],
      "speeds": [
        {
          "Walk": 40
        }
      ],
      "senses": [
        {
          "sense": "Darkvision",
          "rangeFt": 120
        }
      ],
      "damageModifiers": [
        {
          "modifier": "Immunity",
          "damageType": "Lightning"
        }
      ],
      "conditionImmunities": [
        "Exhaustion",
        "Paralyzed"
      ],
      "languages": [
        "All"
      ],
      "abilities": [
        {
          "category": "Trait",
          "name": "Aura of Menace",
          "description": "As long as the archon doesn't have the incapacitated condition, each creature of the archon's choice that starts its turn within 20 feet of the archon must make a DC 12 Wisdom saving throw. On a failed save, the creature has the frightened condition until the start of its next turn. On a successful save, the creature is immune to all archons' Aura of Menace for 24 hours."
        },
        {
          "category": "Action",
          "name": "Multiattack",
          "description": "The archon makes two Bite attacks. It can replace one of the attacks with a Shining Blade attack."
        },
        {
          "category": "Action",
          "name": "Bite",
          "description": "Melee Weapon Attack: +6 to hit, reach 5 ft., one target. Hit: 7 (1d6 + 4) piercing damage. If the target is a Large or smaller creature, it must succeed on a DC 14 Strength saving throw or have the prone condition."
        },
        {
          "category": "Action",
          "name": "Shining Blade (True Form Only)",
          "description": "Melee Weapon Attack: +6 to hit, reach 5 ft., one target. Hit: 11 (2d6 + 4) radiant damage."
        },
        {
          "category": "Action",
          "name": "Spellcasting",
          "description": "The archon casts one of the following spells, requiring no material components and using Charisma as the spellcasting ability:\nAt will: detect evil and good\n1/day each: aid, continual flame"
        },
        {
          "category": "Action",
          "name": "Teleport",
          "description": "The archon teleports, along with any equipment it is wearing or carrying, to an unoccupied space it can see within 120 feet of itself."
        },
        {
          "category": "Bonus Action",
          "name": "Change Shape",
          "description": "The archon magically transforms into any Medium or Large dog or wolf while retaining its game statistics (other than its size and losing its Shining Blade attack). The archon reverts to its true form if reduced to 0 hit points or if it uses a bonus action to do so."
        }
      ],
      "tags": [
        "Shapechanger",
        "Celestial",
        "Archon"
      ]
    },
