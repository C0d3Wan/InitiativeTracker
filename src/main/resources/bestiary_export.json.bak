        {
          "Climb": 40
        }
      ],
      "senses": [
        {
          "sense": "Darkvision",
          "rangeFt": 120
        },
        {
          "sense": "Blindsight",
          "rangeFt": 60
        }
      ],
      "damageModifiers": [
        {
          "modifier": "Resistance",
          "damageType": "Necrotic"
        },
        {
          "modifier": "Immunity",
          "damageType": "Fire"
        }
      ],
      "conditionImmunities": [],
      "languages": [
        "Common",
        "Draconic"
      ],
      "abilities": [
        {
          "category": "Action",
          "name": "Bite",
          "description": "Melee Weapon Attack: +14 to hit, reach 10 ft., one target. Hit: 19 (2d10 + 8) piercing damage plus 7 (2d6) necrotic damage."
        },
        {
          "category": "Action",
          "name": "Claw",
          "description": "Melee Weapon Attack: +14 to hit, reach 5 ft., one target. Hit: 15 (2d6 + 8) slashing damage."
        },
        {
          "category": "Action",
          "name": "Frightful Presence",
          "description": "Each creature of the dragon's choice that is within 120 feet of the dragon and aware of it must succeed on a DC 19 Wisdom saving throw or become frightened for 1 minute. A creature can repeat the saving throw at the end of each of its turns, ending the effect on itself on a success. If a creature's saving throw is successful or the effect ends for it, the creature is immune to the dragon's Frightful Presence for the next 24 hours."
        },
        {
          "category": "Action",
          "name": "Multiattack",
          "description": "The dragon can use its Frightful Presence. It then makes three attacks: one with its bite and two with its claws."
        },
        {
          "category": "Action",
          "name": "Shadow Breath",
          "description": "The dragon exhales shadowy fire in a 60-foot cone. Each creature in that area must make a DC 21 Dexterity saving throw, taking 63 (18d6) necrotic damage on a failed save, or half as much damage on a successful one. A humanoid reduced to 0 hit points by this damage dies, and an undead shadow rises from its corpse and acts immediately after the dragon in the initiative count under the dragon's control.",
          "recharge": "5-6"
        },
        {
          "category": "Action",
          "name": "Tail",
          "description": "Melee Weapon Attack: +14 to hit, reach 15 ft., one target. Hit: 17 (2d8 + 8) bludgeoning damage."
        },
        {
          "category": "Lair Action",
          "name": "Lair Actions",
          "description": "When fighting inside its lair, the dragon can invoke ambient magic on initiative count 20 (losing initiative ties) to take one of the following lair actions:\n• Magma erupts from a point on the ground within 120 feet, creating a 20-foot-high, 5-foot-radius geyser. Each creature in the geyser's area must make a DC 15 Dexterity saving throw, taking 21 (6d6) fire damage on a failed save, or half on a success.\n• A tremor shakes the lair in a 60-foot radius around the dragon. Each creature other than the dragon on the ground in that area must succeed on a DC 15 Dexterity saving throw or be knocked prone.\n• Volcanic gases form a cloud in a 20-foot-radius sphere centered on a point within 120 feet. Each creature that starts its turn in the cloud must succeed on a DC 13 Constitution saving throw or be poisoned and incapacitated until the end of its turn."
        },
        {
          "category": "Legendary Action",
          "name": "Detect",
          "description": "The dragon makes a Wisdom (Perception) check."
        },
        {
          "category": "Legendary Action",
          "name": "Tail Attack",
          "description": "The dragon makes a tail attack."
        },
        {
          "category": "Legendary Action",
          "name": "Wing Attack (Costs 2 Actions)",
          "description": "The dragon beats its wings. Each creature within 10 feet of the dragon must succeed on a DC 22 Dexterity saving throw or take 15 (2d6 + 8) bludgeoning damage and be knocked prone. The dragon can then fly up to half its flying speed."
        },
        {
          "category": "Trait",
          "name": "Legendary Resistance (3/Day)",
          "description": "If the dragon fails a saving throw, it can choose to succeed instead.",
          "recharge": "3/Day"
        },
        {
          "category": "Trait",
          "name": "Living Shadow",
          "description": "While in dim light or darkness, the dragon has resistance to damage that isn't force, psychic, or radiant."
        },
        {
          "category": "Trait",
          "name": "Shadow Stealth",
          "description": "While in dim light or darkness, the dragon can take the Hide action as a bonus action."
        },
        {
          "category": "Trait",
          "name": "Sunlight Sensitivity",
          "description": "While in sunlight, the dragon has disadvantage on attack rolls, as well as on Wisdom (Perception) checks that rely on sight."
        }
      ],
      "tags": [
        "Red Dragon",
        "Shadow Dragon"
      ]
    },
