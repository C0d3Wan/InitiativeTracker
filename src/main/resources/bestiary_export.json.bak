        {
          "category": "Trait",
          "name": "Cycle of Rebirth",
          "description": "If the dragon dies, its soul coalesces into a steely egg immune to all damage and teleports to a random plane, hatching after 1d100 years with all previous memories."
        },
        {
          "category": "Trait",
          "name": "Legendary Resistance (5/Day)",
          "description": "If the dragon fails a saving throw, it can choose to succeed instead.",
          "recharge": "5/Day"
        },
        {
          "category": "Action",
          "name": "Multiattack",
          "description": "The dragon makes three Rend attacks."
        },
        {
          "category": "Action",
          "name": "Rend",
          "description": "Melee Weapon Attack: +17 to hit, reach 15 ft., one target. Hit: 22 (3d8 + 9) slashing damage plus 10 (3d6) force damage."
        },
        {
          "category": "Action",
          "name": "Time Breath",
          "description": "Exhales shimmering light in a 90-foot cone. Each creature must make a DC 24 Constitution saving throw, taking 52 (8d12) force damage and becoming desynchronized (attack rolls against it have advantage, poisoned, and other creatures have resistance to its damage; ends after 3 successful end-of-turn saves) on a failed save, or half damage on a success.",
          "recharge": "5-6"
        },
        {
          "category": "Action",
          "name": "Time Gate (1/Day)",
          "description": "Conjures a 20-foot-diameter circular portal linking to any plane up to 8,000 years in the past or future for 24 hours.",
          "recharge": "1/Day"
        },
        {
          "category": "Reaction",
          "name": "Reactive Rend",
          "description": "The dragon can take up to three reactions per round. After using Legendary Resistance or being hit by an attack roll, makes one Rend attack."
        },
        {
          "category": "Reaction",
          "name": "Slow Time",
          "description": "Targets a creature within 90 feet weakened by Time Breath, reducing its speed to 0 until the weakened effect ends."
        },
        {
          "category": "Reaction",
          "name": "Time Slip",
          "description": "Halves damage from an attack and immediately teleports up to 60 feet."
        },
        {
          "category": "Lair Action",
          "name": "Lair Actions",
          "description": "On initiative count 20: Temporal Fling (DC 18 Wisdom save or 26 [4d12] psychic damage and flung 1 round into the future), Temporal Lag (60 ft. slow), or Timeline Divergence."
        }
      ],
      "tags": [
        "Flying",
        "Legendary",
        "Dragon",
        "Time Dragon"
      ]
    },
