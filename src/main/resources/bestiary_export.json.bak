    {
      "name": "Adult Black Dracolich",
      "group": "Dragon",
      "type": "Undead",
      "size": "Huge",
      "alignment": "Chaotic Evil",
      "challengeRating": 15.0,
      "armorClass": 19,
      "hpAverage": 195,
      "hpFormula": "17d12 + 85",
      "experiencePoints": 13000,
      "passivePerception": 21,
      "proficiencyBonus": 5,
      "description": "An undead adult black dragon transformed by necromantic rituals into a skeletal tyrant.",
      "isOfficial": true,
      "stats": {
        "strength": 23,
        "dexterity": 14,
        "constitution": 21,
        "intelligence": 14,
        "wisdom": 13,
        "charisma": 17
      },
      "savingThrows": [
        {
