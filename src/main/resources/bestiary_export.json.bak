      "name": "Ancient Bronze Shadow Dragon",
      "group": "Dragon",
      "type": "Dragon",
      "size": "Gargantuan",
      "alignment": "Neutral Good",
      "challengeRating": 22.0,
      "armorClass": 22,
      "hpAverage": 444,
      "hpFormula": "24d20 + 192",
      "experiencePoints": 33000,
      "passivePerception": 27,
